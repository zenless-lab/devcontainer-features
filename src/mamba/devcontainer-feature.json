{
    "name": "Mamba",
    "id": "mamba",
    "version": "1.1.0",
    "description": "Installs Mamba, a fast, robust, and cross-platform package manager. It is a reimplementation of the conda package manager in C++.",
    "documentationURL": "https://github.com/zenless-lab/devcontainer-features/tree/main/src/mamba",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest"
            ],
            "default": "latest",
            "description": "Select the version of Mamba to install."
        },
        "initShells": {
            "type": "string",
            "proposals": [
                "bash",
                "zsh,bash",
                "none"
            ],
            "default": "bash",
            "description": "Select the shell(s) to initialize, separated by commas."
        }
    },
    "dependsOn": {
        "ghcr.io/zenless-lab/devcontainer-features/pkg:1": {
            "apt": "sudo,curl,ca-certificates",
            "pacman": "sudo,curl,ca-certificates",
            "dnf": "sudo,curl,ca-certificates",
            "yum": "sudo,curl,ca-certificates",
            "emerge": "app-admin/sudo,net-misc/curl,app-misc/ca-certificates",
            "rpmOstree": "sudo,curl,ca-certificates",
            "zypper": "sudo,curl,ca-certificates",
            "apk": "sudo,curl,ca-certificates"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
