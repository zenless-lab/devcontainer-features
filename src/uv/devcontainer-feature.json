{
    "name": "uv",
    "id": "uv",
    "version": "1.2.0",
    "description": "An extremely fast Python package installer and resolver, written in Rust.",
    "documentationURL": "https://github.com/zenless-lab/devcontainer-features/tree/main/src/uv",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "0.9.24"
            ],
            "default": "latest",
            "description": "Select the version of uv to install."
        },
        "completionShell": {
            "type": "string",
            "proposals": [
                "automatic",
                "bash,zsh,fish",
                ""
            ],
            "default": "automatic",
            "description": "Install autocompletion for a specific shell, or try to detect automatically."
        },
        "toolsToInstall": {
            "type": "string",
            "default": "ruff,pytest,ty,black,pyright,pre-commit,rust-just",
            "description": "Comma-separated list of CLI tools to install with uv tool install. Set to empty string to skip tool installation."
        }
    },
    "containerEnv": {
        "UV_PYTHON_INSTALL_DIR": "/opt/uv/python",
        "UV_CACHE_DIR": "/opt/uv/cache",
        "VIRTUAL_ENV": "/opt/uv/venv"
    },
    "dependsOn": {
        "ghcr.io/zenless-lab/devcontainer-features/pkg:2": {
            "pkg": "sudo curl ca-certificates"
        }
    },
    "mounts": [
        {
            "source": "uv-${devcontainerId}",
            "target": "/opt/uv",
            "type": "volume"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/uv/venv/bin/python"
            }
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
