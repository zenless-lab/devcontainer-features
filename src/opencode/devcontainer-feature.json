{
    "id": "opencode",
    "version": "1.1.0",
    "name": "OpenCode",
    "description": "Installs OpenCode CLI",
    "options": {
        "opencodeVersion": {
            "type": "string",
            "proposals": ["latest"],
            "default": "latest",
            "description": "Select the version to install."
        },
        "shellInit": {
            "type": "string",
            "proposals": [
                "automatic",
                "sh,bash"
            ],
            "default": "automatic",
            "description": "Initialize shell completions for the specified shell(s). Comma-separated list of shells or 'automatic' to detect the current shell."
        }
    },
    "dependsOn": {
        "ghcr.io/zenless-lab/devcontainer-features/pkg:1": {
            "apt": "sudo,curl,ca-certificates",
            "pacman": "sudo,curl,ca-certificates",
            "dnf": "sudo,curl,ca-certificates",
            "yum": "sudo,curl,ca-certificates",
            "emerge": "app-admin/sudo,net-misc/curl,app-misc/ca-certificates",
            "rpmOstree": "sudo,curl,ca-certificates",
            "zypper": "sudo,curl,ca-certificates",
            "apk": "sudo,curl,ca-certificates"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
