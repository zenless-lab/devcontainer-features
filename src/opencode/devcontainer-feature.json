{
    "id": "opencode",
    "version": "0.1.0",
    "name": "OpenCode",
    "description": "Installs OpenCode CLI",
    "options": {
        "opencodeVersion": {
            "type": "string",
            "proposals": ["latest"],
            "default": "latest",
            "description": "Select the version to install."
        },
        "shellInit": {
            "type": "string",
            "proposals": [
                "automatic",
                "sh,bash"
            ],
            "default": "automatic",
            "description": "Initialize shell completions for the specified shell(s). Comma-separated list of shells or 'automatic' to detect the current shell."
        }
    },
    "dependsOn": {
        "ghcr.io/zenless-lab/devcontainer-features/pkg:2": {
            "pkg": "sudo curl ca-certificates"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
