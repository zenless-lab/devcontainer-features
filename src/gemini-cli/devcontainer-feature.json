{
    "id": "gemini-cli",
    "version": "0.2.0",
    "name": "Gemini CLI",
    "description": "Installs Google Gemini CLI.",
    "documentationURL": "https://github.com/zenless-lab/devcontainer-features/tree/main/src/gemini-cli",
    "options": {
        "geminiCliVersion": {
            "type": "string",
            "proposals": [
                "latest",
                "0.34.0"
            ],
            "default": "latest",
            "description": "Select the Gemini CLI version to install."
        }
    },
    "containerEnv": {
        "GEMINI_SANDBOX": "false"
    },
    "mounts": [
        {
            "type": "volume",
            "source": "devcontainer-gemini-cli",
            "target": "/opt/gemini-cli"
        }
    ],
    "dependsOn": {
        "ghcr.io/zenless-lab/devcontainer-features/pkg:2": {
            "pkg": "acl sudo"
        },
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "postCreateCommand": [
        "/usr/local/share/acl-scripts/gemini-cli-acls.sh"
    ],
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
