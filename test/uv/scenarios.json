{
    "latest": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "uv": {
                "version": "latest"
            }
        }
    },
    "specific_version": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "uv": {
                "version": "0.9.24"
            }
        }
    },
    "completion": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "uv": {
                "completion_shell": "bash"
            }
        }
    },
    "python_versions": {
        "image": "mcr.microsoft.com/devcontainers/base:debian",
        "features": {
            "uv": {
                "python_versions": "3.10,3.11,3.12"
            }
        }
    }
}
